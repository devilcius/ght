{
  "name": "ght-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var LOCAL_DEVELOPMENT:true",
    "db:migrate": "wrangler d1 migrations apply ght --local",
    "db:seed": "wrangler d1 execute ght --local --file=./seed.sql",
    "test": "npm run check && npm run test:unit && npm run test:python && npm run test:integration",
    "test:unit": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:integration": "python3 tests/gallery_integration.py",
    "check": "find src public scripts -name '*.js' -print0 | xargs -0 -n 1 node --check"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "wrangler": "^4.64.0"
  }
}
