{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ght-portfolio",
  "main": "src/index.js",
  "compatibility_date": "2026-02-10",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "ght", "database_id": "local-placeholder", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "ght-media"}]
}
